# Copia este archivo como .env para desarrollo local. Valores de ejemplo, sin secretos reales.
DATABASE_URL=postgresql+psycopg://skilltrack:skilltrack@localhost:5432/skilltrack

# Pago por QR: "simulado" (predeterminado, nunca llama al banco) o "baneco" (Banco Económico).
# Con baneco, todas las variables BANECO_ son obligatorias y la llave AES mide 32 caracteres.
# Ver docs/05-despliegue/pago-qr.md. Nunca escribas aquí los valores reales.
PAGOS_PROVEEDOR=simulado
BANECO_API_URL=
BANECO_USUARIO=
BANECO_CONTRASENA=
BANECO_CUENTA=
BANECO_LLAVE_AES=
# Aviso de pago del banco: apagado; IPs del banco separadas por comas (vacío = rechaza todo).
BANECO_AVISO_ACTIVO=false
BANECO_AVISO_IPS=
