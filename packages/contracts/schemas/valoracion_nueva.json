{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "valor": {
      "type": "string",
      "enum": [
        "lograda",
        "por_repetir"
      ]
    },
    "observacion": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "clase_error_id": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "texto": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": [
            "clase_error_id",
            "texto"
          ],
          "additionalProperties": false,
          "title": "ObservacionDeValoracion"
        },
        {
          "type": "null"
        }
      ]
    },
    "fecha_limite": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "valor"
  ],
  "additionalProperties": false,
  "title": "ValoracionNueva"
}
