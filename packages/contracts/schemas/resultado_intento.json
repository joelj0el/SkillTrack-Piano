{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 2
    },
    "client_uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "version_ejercicio_id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "tarea_id": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "version_nucleo": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "version_modelo_mano": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "instrumento": {
      "type": "string",
      "enum": [
        "acustico",
        "digital",
        "teclado",
        "no_declarado"
      ]
    },
    "manos": {
      "type": "string",
      "enum": [
        "MI",
        "MD",
        "juntas"
      ]
    },
    "clase_dispositivo": {
      "type": "string",
      "maxLength": 40
    },
    "modo": {
      "type": "string",
      "enum": [
        "V",
        "A",
        "VA"
      ]
    },
    "modo_metronomo": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "con",
            "sin"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "tempo_elegido_bpm": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 40,
          "maximum": 75
        },
        {
          "type": "null"
        }
      ]
    },
    "estado": {
      "type": "string",
      "enum": [
        "evaluado",
        "no_evaluable"
      ]
    },
    "motivo_no_evaluable": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 120
        },
        {
          "type": "null"
        }
      ]
    },
    "iniciado_en": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "duracion_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pct_eventos_evaluables": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "pct_digitacion_correcta": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "secuencia_esperada": {
      "type": "string",
      "enum": [
        "partitura",
        "provisional"
      ]
    },
    "referencia_id": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "conjunto_reglas_id": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "calificacion": {
      "anyOf": [
        {
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "clase": {
                "type": "string",
                "enum": [
                  "ER-A",
                  "ER-B",
                  "ER-C",
                  "ER-D",
                  "ER-E",
                  "ER-F"
                ],
                "title": "CodigoClase"
              },
              "nivel": {
                "type": "string",
                "enum": [
                  "logrado",
                  "en-desarrollo",
                  "por-mejorar",
                  "no-evaluado"
                ]
              },
              "pct": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "clase",
              "nivel",
              "pct"
            ],
            "additionalProperties": false,
            "title": "CalificacionVariable"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "indicadores_deficientes": {
      "anyOf": [
        {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "IND-A1",
              "IND-B1",
              "IND-B2",
              "IND-B3",
              "IND-C1",
              "IND-D1",
              "IND-D2",
              "IND-E1",
              "IND-F1",
              "IND-F2",
              "IND-F3",
              "IND-F4"
            ],
            "title": "CodigoIndicador"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "tempo_medido_bpm": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 400
        },
        {
          "type": "null"
        }
      ]
    },
    "referencia_temporal": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "tempo_elegido",
            "tempo_inicial"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "cambio_tempo_pct": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -100,
          "maximum": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "audio_sin_procesar": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "eventos": {
      "maxItems": 400,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "idx": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "mano": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "MI",
                  "MD"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "midi_esperado": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              {
                "type": "null"
              }
            ]
          },
          "dedo_esperado": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              {
                "type": "null"
              }
            ]
          },
          "estado": {
            "type": "string",
            "enum": [
              "evaluado",
              "no-evaluable"
            ]
          },
          "motivo": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ]
          },
          "ataque_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "modalidad": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "A",
                  "V",
                  "VA"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "nota": {
            "type": "object",
            "properties": {
              "estado": {
                "type": "string",
                "enum": [
                  "correcta",
                  "incorrecta",
                  "dudosa",
                  "faltante",
                  "sin-dato"
                ]
              },
              "midi": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 127
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "clase_oida": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 11
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "modalidad": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "A",
                      "V",
                      "VA"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "estado",
              "midi",
              "clase_oida",
              "modalidad"
            ],
            "additionalProperties": false
          },
          "dedo": {
            "type": "object",
            "properties": {
              "valor": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "estado": {
                "type": "string",
                "enum": [
                  "correcto",
                  "incorrecto",
                  "sin-esperado",
                  "no-detectado"
                ]
              },
              "modalidad": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "V"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "valor",
              "estado",
              "modalidad"
            ],
            "additionalProperties": false
          },
          "tecla": {
            "type": "object",
            "properties": {
              "midi": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 127
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "zona": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "modalidad": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "V"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "midi",
              "zona",
              "modalidad"
            ],
            "additionalProperties": false
          },
          "desfase_manos": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "estado": {
                    "type": "string",
                    "enum": [
                      "a-tiempo",
                      "tarde",
                      "una-nota-atras",
                      "no-medible"
                    ]
                  },
                  "ms": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "mano_tarde": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "MI",
                          "MD"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "modalidad": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "A",
                          "V",
                          "VA"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "estado",
                  "ms",
                  "mano_tarde",
                  "modalidad"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "rasgos": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 40
            },
            "additionalProperties": {
              "type": "number"
            }
          },
          "rasgos_modalidad": {
            "anyOf": [
              {
                "type": "string",
                "const": "V"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "idx",
          "mano",
          "midi_esperado",
          "dedo_esperado",
          "estado",
          "motivo",
          "ataque_ms",
          "modalidad",
          "nota",
          "dedo",
          "tecla",
          "desfase_manos",
          "rasgos",
          "rasgos_modalidad"
        ],
        "additionalProperties": false,
        "title": "EventoResultado"
      }
    }
  },
  "required": [
    "version",
    "client_uuid",
    "version_ejercicio_id",
    "tarea_id",
    "version_nucleo",
    "version_modelo_mano",
    "instrumento",
    "manos",
    "clase_dispositivo",
    "modo",
    "modo_metronomo",
    "tempo_elegido_bpm",
    "estado",
    "motivo_no_evaluable",
    "iniciado_en",
    "duracion_ms",
    "pct_eventos_evaluables",
    "pct_digitacion_correcta",
    "tempo_medido_bpm",
    "referencia_temporal",
    "cambio_tempo_pct",
    "audio_sin_procesar",
    "eventos"
  ],
  "additionalProperties": false,
  "title": "ResultadoIntento"
}
