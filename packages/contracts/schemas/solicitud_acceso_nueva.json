{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "institucion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "correo": {
      "type": "string",
      "maxLength": 254,
      "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
    },
    "telefono": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9 +()-]{6,20}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_id": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "mensaje": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "nombre",
    "institucion",
    "correo",
    "telefono",
    "plan_id",
    "mensaje"
  ],
  "additionalProperties": false,
  "title": "SolicitudAccesoNueva"
}
