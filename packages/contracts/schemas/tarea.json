{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "estudiante_id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "docente_id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "ejercicio": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "codigo": {
          "type": "string"
        },
        "nombre": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "codigo",
        "nombre"
      ],
      "additionalProperties": false,
      "title": "EjercicioDeTarea"
    },
    "manos": {
      "type": "string",
      "enum": [
        "MI",
        "MD",
        "juntas"
      ]
    },
    "tempo_min_bpm": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "tempo_max_bpm": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "repeticiones_por_dia": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "fecha_limite": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "estado": {
      "type": "string",
      "enum": [
        "Asignada",
        "Vencida",
        "Cancelada"
      ]
    },
    "observaciones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "tarea_id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "aspecto": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "codigo": {
                    "type": "string"
                  },
                  "nombre": {
                    "type": "string"
                  }
                },
                "required": [
                  "codigo",
                  "nombre"
                ],
                "additionalProperties": false,
                "title": "Aspecto"
              },
              {
                "type": "null"
              }
            ]
          },
          "texto": {
            "type": "string"
          },
          "creada_en": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "id",
          "tarea_id",
          "aspecto",
          "texto",
          "creada_en"
        ],
        "additionalProperties": false,
        "title": "Observacion"
      }
    }
  },
  "required": [
    "id",
    "estudiante_id",
    "docente_id",
    "ejercicio",
    "manos",
    "tempo_min_bpm",
    "tempo_max_bpm",
    "repeticiones_por_dia",
    "fecha_limite",
    "estado",
    "observaciones"
  ],
  "additionalProperties": false,
  "title": "Tarea"
}
