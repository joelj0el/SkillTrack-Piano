{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tarea_id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "meta_por_dia": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "hoy": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "validas_hoy": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "dias": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fecha": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "validas": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "meta": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "fecha",
          "validas",
          "meta"
        ],
        "additionalProperties": false,
        "title": "DiaDeAvance"
      }
    },
    "intentos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "iniciado_en": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "estado": {
            "type": "string",
            "enum": [
              "evaluado",
              "no_evaluable"
            ]
          },
          "tempo_elegido_bpm": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "tempo_medido_bpm": {
            "type": [
              "number",
              "null"
            ]
          },
          "cuenta_para_tarea": {
            "type": "boolean"
          },
          "motivo_no_cuenta": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "iniciado_en",
          "estado",
          "tempo_elegido_bpm",
          "tempo_medido_bpm",
          "cuenta_para_tarea",
          "motivo_no_cuenta"
        ],
        "additionalProperties": false,
        "title": "IntentoDeAvance"
      }
    }
  },
  "required": [
    "tarea_id",
    "meta_por_dia",
    "hoy",
    "validas_hoy",
    "dias",
    "intentos"
  ],
  "additionalProperties": false,
  "title": "AvanceTarea"
}
