{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "suscripcion_id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "institucion": {
      "type": "string"
    },
    "plan": {
      "type": "string"
    },
    "monto_bs": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        {
          "type": "null"
        }
      ]
    },
    "codigo_convenio": {
      "type": [
        "string",
        "null"
      ]
    },
    "nombre": {
      "type": "string"
    },
    "usuario": {
      "type": "string"
    },
    "correo": {
      "type": [
        "string",
        "null"
      ]
    },
    "telefono": {
      "type": [
        "string",
        "null"
      ]
    },
    "creada_en": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "qr_generado": {
      "type": "boolean"
    }
  },
  "required": [
    "suscripcion_id",
    "institucion",
    "plan",
    "monto_bs",
    "codigo_convenio",
    "nombre",
    "usuario",
    "correo",
    "telefono",
    "creada_en",
    "qr_generado"
  ],
  "additionalProperties": false,
  "title": "CuentaPendiente"
}
