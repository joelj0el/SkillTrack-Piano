{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "estudiante_id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "ejercicio_id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "manos": {
      "type": "string",
      "enum": [
        "MI",
        "MD",
        "juntas"
      ]
    },
    "tempo_min_bpm": {
      "type": "integer",
      "minimum": 60,
      "maximum": 75
    },
    "tempo_max_bpm": {
      "type": "integer",
      "minimum": 60,
      "maximum": 75
    },
    "repeticiones_por_dia": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "fecha_limite": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    }
  },
  "required": [
    "estudiante_id",
    "ejercicio_id",
    "manos",
    "tempo_min_bpm",
    "tempo_max_bpm",
    "repeticiones_por_dia",
    "fecha_limite"
  ],
  "additionalProperties": false,
  "title": "TareaNueva"
}
