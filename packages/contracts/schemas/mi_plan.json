{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "institucion": {
      "type": "string"
    },
    "suscripcion": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "institucion_id": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "institucion": {
              "type": "string"
            },
            "plan": {
              "type": "string"
            },
            "plan_id": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "estado": {
              "type": "string",
              "enum": [
                "pendiente",
                "activa",
                "vencida",
                "cancelada"
              ]
            },
            "inicio": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "fin": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "convenio": {
              "type": "boolean"
            },
            "condiciones": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 1000
                },
                {
                  "type": "null"
                }
              ]
            },
            "limite_docentes": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000
                },
                {
                  "type": "null"
                }
              ]
            },
            "limite_estudiantes": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "institucion_id",
            "institucion",
            "plan",
            "plan_id",
            "estado",
            "inicio",
            "fin",
            "convenio",
            "condiciones",
            "limite_docentes",
            "limite_estudiantes"
          ],
          "additionalProperties": false,
          "title": "Suscripcion"
        },
        {
          "type": "null"
        }
      ]
    },
    "limite_docentes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        {
          "type": "null"
        }
      ]
    },
    "limite_estudiantes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        {
          "type": "null"
        }
      ]
    },
    "docentes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "estudiantes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pago_qr": {
      "type": "boolean"
    }
  },
  "required": [
    "institucion",
    "suscripcion",
    "limite_docentes",
    "limite_estudiantes",
    "docentes",
    "estudiantes",
    "pago_qr"
  ],
  "additionalProperties": false,
  "title": "MiPlan"
}
