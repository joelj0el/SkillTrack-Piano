# Copia este archivo como /opt/skilltrack/.env en la máquina virtual y completa los valores.
# Nunca lo subas al repositorio con valores reales.

# Dueño y nombre del repositorio en minúsculas: las imágenes son ghcr.io/<IMAGENES>/api y /web.
IMAGENES=usuario/skilltrack-piano

# Commit desplegado. El flujo de despliegue lo actualiza en cada despliegue.
ETIQUETA=

# Nombre público de la máquina virtual (por ejemplo, <etiqueta>.<región>.cloudapp.azure.com).
DOMINIO=

# Correo para avisos de Let's Encrypt sobre el certificado.
CORREO_ACME=

# Azure Database for PostgreSQL: el servicio administrado exige TLS (sslmode=require).
DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@SERVIDOR.postgres.database.azure.com:5432/skilltrack?sslmode=require
