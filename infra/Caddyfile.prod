# Producción: el mismo origen único que en local (la PWA en / y la API en /api), con un
# certificado público de Let's Encrypt para el dominio. Las cabeceras y las rutas son idénticas a
# las de infra/Caddyfile: una prueba lo comprueba.
{
	email {$CORREO_ACME}
}

{$DOMINIO} {
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; connect-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data: blob:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Permissions-Policy "camera=(self), microphone=(self)"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv

		@inmutables path /assets/*
		header @inmutables Cache-Control "public, max-age=31536000, immutable"
		@revalidar not path /assets/*
		header @revalidar Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
