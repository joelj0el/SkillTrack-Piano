{
  "name": "skilltrack-piano",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @skilltrack/web dev",
    "build": "pnpm --filter @skilltrack/web build",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "format": "node tools/formato.mjs --write",
    "format:check": "node tools/formato.mjs --check",
    "typecheck": "pnpm -r typecheck",
    "deps:check": "depcruise apps/web/src packages research/node/src --config .dependency-cruiser.cjs",
    "contracts:gen": "pnpm --filter @skilltrack/contracts export && uv run --project apps/api datamodel-codegen --input packages/contracts/schemas --input-file-type jsonschema --output apps/api/app/contracts_gen --output-model-type pydantic_v2.BaseModel --target-python-version 3.12 --disable-timestamp --use-double-quotes --formatters builtin --use-title-as-name && node tools/normalizar-lf.ts apps/api/app/contracts_gen",
    "docs:diagrams": "node tools/docs/diagrams.mjs",
    "docs:er": "uv run tools/docs/er.py",
    "docs:tests": "uv run tools/docs/pruebas.py",
    "docs:trace": "uv run tools/docs/traza.py",
    "docs:build": "node tools/docs/build.mjs",
    "e2e": "playwright test",
    "mediapipe": "node tools/mediapipe.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
